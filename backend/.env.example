# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Brain for structuring, answers and meetings (any chat model with structured outputs)
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text model
OPENAI_STT_MODEL=whisper-1
# Public URL of the frontend, so printed QR codes open the phone page
KNOWFLOW_PUBLIC_URL=
# 1 = load demo data on first start
KNOWFLOW_SEED=1
# 1 = allow POST /admin/reset-demo (turn off in production)
KNOWFLOW_ALLOW_RESET=1
